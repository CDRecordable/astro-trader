# ============================================================
# Landing / licence server
# ============================================================

# Canonical URL — used for SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://astrotrader.app

# ── Licence signing (Ed25519) ────────────────────────────────
# Generate a pair ONCE and keep the private key secret (Railway env var).
# The matching PUBLIC key must be pasted into src/lib/license.ts in the app,
# which is what lets licences verify offline on the user's machine.
#
#   node -e "const c=require('crypto');const {publicKey:a,privateKey:b}=c.generateKeyPairSync('ed25519');console.log(a.export({type:'spki',format:'pem'}).toString());console.log(b.export({type:'pkcs8',format:'pem'}).toString())"
#
# Newlines may be written as \n — the code restores them.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ── Payments ─────────────────────────────────────────────────
# Provider is a business choice (who is merchant of record for EU VAT);
# the code supports either without changes.
PAYMENT_PROVIDER=lemonsqueezy          # or: stripe
PAYMENT_CHECKOUT_URL=                  # hosted payment link — leave empty to show "coming soon"
PAYMENT_WEBHOOK_SECRET=                # signing secret for webhook verification

# ── Licence storage ──────────────────────────────────────────
# Where issued licences are recorded so buyers can recover their key.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
